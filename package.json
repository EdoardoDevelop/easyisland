{
  "name": "easyisland",
  "private": true,
  "version": "1.0.53",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "ui": "vite --open \"/?revealDuration=3\"",
    "build": "tsc --noEmit && node scripts/check-i18n.mjs && vite build",
    "check:i18n": "node scripts/check-i18n.mjs",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.mjs",
    "tauri": "tauri",
    "predev": "cargo build --release -p easyisland-hook",
    "prebuild": "cargo build --release -p easyisland-hook",
    "prova": "npm run build && cargo build --profile prova -p easyisland --features tauri/custom-protocol",
    "pack": "cargo clean --release -p easyisland-hook && tauri build && node scripts/pack.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:rapido": "node scripts/smoke.mjs chat overview agenti agentchat impostazioni/chat"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.6.0",
    "vite": "^6"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "1.0.19",
    "@tauri-apps/api": "^2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "0.15.0",
    "@xterm/addon-unicode11": "0.8.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/xterm": "^5.5.0",
    "dockview-core": "8.9.1",
    "highlight.js": "11.11.1"
  }
}
