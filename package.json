{
  "name": "easyisland",
  "private": true,
  "version": "1.0.46",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "ui": "vite --open \"/?revealDuration=3\"",
    "build": "tsc --noEmit && node scripts/check-i18n.mjs && vite build",
    "check:i18n": "node scripts/check-i18n.mjs",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.mjs",
    "tauri": "tauri",
    "predev": "cargo build --release -p easyisland-hook",
    "prebuild": "cargo build --release -p easyisland-hook",
    "pack": "tauri build && node scripts/pack.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:rapido": "node scripts/smoke.mjs chat overview agenti agentchat impostazioni/chat"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.6.0",
    "vite": "^6"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0"
  }
}
